#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
venv_python="$project_dir/.venv/bin/python"

if [ ! -x "$venv_python" ]; then
    printf '%s\n' "Missing $venv_python. Follow the installation steps in README.md." >&2
    exit 2
fi

cd "$project_dir"
exec "$venv_python" -m checker.cli "$@"
